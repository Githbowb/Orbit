<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notif_expanded_root"
    android:layout_width="match_parent"
    android:layout_height="180dp"
    android:background="#1B202E">

    <!-- Full Background Media Cover Image -->
    <ImageView
        android:id="@+id/notif_bg_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <!-- Dark Contrast Gradient Scrim -->
    <ImageView
        android:id="@+id/notif_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/bg_notif_scrim_expanded"
        android:contentDescription="@null" />

    <!-- Content Overlaid directly on top of background -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <!-- Top Header: Source badge + Cover Art indicator -->
        <RelativeLayout
            android:id="@+id/notif_top_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true">

            <ImageView
                android:id="@+id/notif_expanded_orbit_icon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_bubble_atom_core"
                android:tint="#FF6B35"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/notif_expanded_header_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/notif_expanded_orbit_icon"
                android:layout_centerVertical="true"
                android:layout_marginStart="6dp"
                android:text="ORBIT • APP SHORTCUT"
                android:textColor="#D9FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:shadowColor="#E6000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="4"
                android:letterSpacing="0.08" />

            <TextView
                android:id="@+id/notif_expanded_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:text="COVER ART"
                android:textColor="#FF6B35"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.06"
                android:shadowColor="#E6000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="4" />
        </RelativeLayout>

        <!-- Bottom Content: App Icon, Title, and Body -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="14dp">

                <ImageView
                    android:id="@+id/notif_app_icon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter"
                    android:contentDescription="@null" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/notif_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:shadowColor="#E6000000"
                    android:shadowDx="0"
                    android:shadowDy="2"
                    android:shadowRadius="6"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/notif_body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="#F0F4F8"
                    android:textSize="13sp"
                    android:shadowColor="#E6000000"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="4"
                    android:singleLine="true"
                    android:ellipsize="end" />
            </LinearLayout>

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_chevron_right"
                android:tint="#D9FFFFFF"
                android:contentDescription="@null" />
        </LinearLayout>
    </RelativeLayout>
</FrameLayout>
