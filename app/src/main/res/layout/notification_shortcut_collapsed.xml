<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notif_collapsed_root"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:background="#151D33">

    <!-- Full Background Media Cover Image -->
    <ImageView
        android:id="@+id/notif_bg_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <!-- Dark Contrast Scrim for text readability -->
    <ImageView
        android:id="@+id/notif_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/bg_notif_scrim_collapsed"
        android:contentDescription="@null" />

    <!-- Main Content Row: Vertically centered in the 64dp card -->
    <RelativeLayout
        android:id="@+id/notif_content_row"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <!-- App Icon -->
        <FrameLayout
            android:id="@+id/notif_icon_container"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true">

            <ImageView
                android:id="@+id/notif_app_icon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:contentDescription="@null" />
        </FrameLayout>

        <!-- Right Indicators: Chevron & optional Cover Art badge -->
        <LinearLayout
            android:id="@+id/notif_right_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/notif_header_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:text="COVER ART"
                android:textColor="#FF6B35"
                android:textSize="9sp"
                android:textStyle="bold"
                android:letterSpacing="0.04"
                android:shadowColor="#E6000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="4" />

            <ImageView
                android:id="@+id/notif_chevron"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_chevron_right"
                android:tint="#D9FFFFFF"
                android:contentDescription="@null" />
        </LinearLayout>

        <!-- Title and Body between Icon and Right Indicators -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/notif_icon_container"
            android:layout_toStartOf="@id/notif_right_container"
            android:layout_centerVertical="true"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/notif_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="14.5sp"
                android:textStyle="bold"
                android:shadowColor="#E6000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="5"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/notif_body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:textColor="#E8EDF5"
                android:textSize="12sp"
                android:shadowColor="#E6000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="4"
                android:singleLine="true"
                android:ellipsize="end" />
        </LinearLayout>
    </RelativeLayout>
</FrameLayout>

